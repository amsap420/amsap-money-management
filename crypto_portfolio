            { id: '29', prob: '15%', action: 'buy', amount: '100 USDT', status: 'تاییدیه صادر شد', note: 'شکست خط خطی و تغییر ماهیت', color: 'emerald' },
            { id: '31', prob: '10%', action: 'sell', amount: '100 %', status: 'تارگت اول (TP1)', note: 'خروج در زون عرضه هفتگی', color: 'rose' },
            { id: '5/6', prob: '5%', action: 'sell', amount: 'فول خروج', status: 'حد ضرر کلی', note: 'شکست زون تقاضای اصلی آلفونسو', color: 'rose' }
        ];

        // Load or Save to LocalStorage
        let assets = JSON.parse(localStorage.getItem('amir_assets')) || initialAssets;
        let scenarios = JSON.parse(localStorage.getItem('amir_scenarios')) || initialScenarios;

        function saveState() {
            localStorage.setItem('amir_assets', JSON.stringify(assets));
            localStorage.setItem('amir_scenarios', JSON.stringify(scenarios));
        }

        // Render Assets Table
        function renderAssets() {
            const tbody = document.getElementById('assets-table-body');
            tbody.innerHTML = '';
            const total = assets.reduce((acc, curr) => acc + curr.usdt, 0);

            assets.forEach((asset, idx) => {
                const percent = ((asset.usdt / total) * 100).toFixed(1);
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/40 transition";
                tr.innerHTML = `
                    <td class="p-2.5 font-bold flex items-center gap-1.5" style="color: ${asset.color}">
                        <span class="w-2 h-2 rounded-full" style="background-color: ${asset.color}"></span>
                        ${asset.name}
                    </td>
                    <td class="p-2.5 font-semibold text-white">
                        <input type="number" value="${asset.usdt}" data-idx="${idx}" class="asset-usdt-input bg-transparent border-b border-dashed border-slate-700 w-16 text-emerald-400 font-bold focus:border-blue-500 outline-none">
                        $
                    </td>
                    <td class="p-2.5 font-mono text-slate-400">${percent}%</td>
                    <td class="p-2.5 text-slate-400 text-[11px]">${asset.note || '-'}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('total-usdt-val').innerText = `${total.toLocaleString()} $`;
            
            // Listen to live asset changes
            document.querySelectorAll('.asset-usdt-input').forEach(input => {
                input.addEventListener('change', (e) => {
                    const idx = e.target.dataset.idx;
                    const newVal = parseFloat(e.target.value) || 0;
                    assets[idx].usdt = newVal;
                    saveState();
                    renderAssets();
                    updateChart();
                });
            });
        }

        // Render Scenario Cards
        function renderScenarios() {
            const container = document.getElementById('scenarios-container');
            container.innerHTML = '';

            scenarios.forEach((sc, idx) => {
                const isBuy = sc.action === 'buy';
                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border bg-slate-900/80 relative overflow-hidden transition ${
                    isBuy ? 'border-emerald-500/30 hover:border-emerald-500' : 'border-rose-500/30 hover:border-rose-500'
                }`;

                card.innerHTML = `
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs font-bold px-2.5 py-0.5 rounded-md ${
                            isBuy ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/10 text-rose-400 border border-rose-500/30'
                        }">
                            سناریو ${sc.id}
                        </span>
                        <span class="text-xs font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                            احتمال: ${sc.prob}
                        </span>
                    </div>

                    <div class="flex items-center justify-between my-2">
                        <div>
                            <span class="text-[11px] text-slate-400 block">نوع اقدام:</span>
                            <span class="text-sm font-bold ${isBuy ? 'text-emerald-400' : 'text-rose-400'} uppercase">
                                ${isBuy ? 'خرید (BUY)' : 'فروش (SELL)'}
                            </span>
                        </div>
                        <div class="text-left">
                            <span class="text-[11px] text-slate-400 block">حجم تخصیص:</span>
                            <span class="text-sm font-bold text-white font-mono">${sc.amount}</span>
                        </div>
                    </div>

                    <div class="bg-slate-800/50 p-2 rounded-lg text-[11px] text-slate-300 mb-2 border border-slate-700/50">
                        <i data-lucide="info" class="w-3 h-3 inline ml-1 text-blue-400"></i> ${sc.note}
                    </div>

                    <div class="flex justify-between items-center pt-1 border-t border-slate-800/80">
                        <span class="text-[10px] text-slate-400">وضعیت ستاپ:</span>
                        <span class="text-[11px] font-semibold text-purple-300 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
                            ${sc.status}
                        </span>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // Initialize Chart.js Donut
        let myChart = null;
        function initChart() {
            const ctx = document.getElementById('portfolioChart').getContext('2d');
            myChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: assets.map(a => a.name),
                    datasets: [{
                        data: assets.map(a => a.usdt),
                        backgroundColor: assets.map(a => a.color),
                        borderWidth: 2,
                        borderColor: '#151c28'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'left',
                            rtl: true,
                            labels: {
                                color: '#cbd5e1',
                                font: { family: 'Vazirmatn', size: 11 },
                                boxWidth: 12,
                                padding: 10
                            }
                        },
                        tooltip: {
                            rtl: true,
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ${context.raw} USDT`;
                                }
                            }
                        }
                    },
                    cutout: '68%'
                }
            });
        }

        function updateChart() {
            if (myChart) {
                myChart.data.labels = assets.map(a => a.name);
                myChart.data.datasets[0].data = assets.map(a => a.usdt);
                myChart.update();
            }
        }

        // Initialize Everything
        window.addEventListener('DOMContentLoaded', () => {
            renderAssets();
            renderScenarios();
            initChart();
        });
    </script>
</body>
</html>
